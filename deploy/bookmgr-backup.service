# One-shot backup of the bookmgr database, started by bookmgr-backup.timer.
#
# Backups are written to /var/lib/bookmgr/backups (owned by bookmgr, mode
# 0700) and the newest BACKUP_KEEP files are kept. bookmgr.env is not loaded
# on purpose: the backup needs only DB_PATH, not the API keys.
#
# Install:
#   sudo cp deploy/bookmgr-backup.service deploy/bookmgr-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bookmgr-backup.timer
# Run once by hand:
#   sudo systemctl start bookmgr-backup.service

[Unit]
Description=Back up the bookmgr database

[Service]
Type=oneshot
User=bookmgr
Group=bookmgr
WorkingDirectory=/opt/bookmgr/server
Environment=DB_PATH=/var/lib/bookmgr/bookmgr.db
Environment=BACKUP_DIR=/var/lib/bookmgr/backups
Environment=BACKUP_KEEP=14
ExecStart=/opt/bookmgr/server/.venv/bin/python -m app.backup
UMask=0077
Nice=10
IOSchedulingClass=idle

# Shares /var/lib/bookmgr with bookmgr.service; keep the mode identical.
StateDirectory=bookmgr
StateDirectoryMode=0700

# Sandboxing: no network at all, the only writable path is /var/lib/bookmgr.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
IPAddressDeny=any
