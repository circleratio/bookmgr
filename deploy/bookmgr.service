# systemd system unit for the bookmgr FastAPI server, running as a dedicated
# unprivileged user. For running under your own account, use
# bookmgr.user.service instead.
#
# Layout assumed by this unit (see README.md for the full procedure):
#   /opt/bookmgr/server          server code and .venv, owned by root (read-only)
#   /opt/bookmgr/db/migrations   SQL migrations, owned by root (read-only). They
#                                are found relative to server/app/config.py, so
#                                keep server/ and db/ side by side.
#   /etc/bookmgr/bookmgr.env     settings incl. API keys, root:root mode 0600
#   /var/lib/bookmgr             database directory, owned by bookmgr
#                                (StateDirectory); set DB_PATH to
#                                /var/lib/bookmgr/bookmgr.db in bookmgr.env
#
# bookmgr.env is read by systemd (PID 1, as root) before dropping privileges,
# so the service user needs no access to it and a compromised app cannot read
# it from disk.
#
# Install:
#   sudo useradd --system --user-group --no-create-home \
#     --home-dir /nonexistent --shell /usr/sbin/nologin bookmgr
#   sudo cp deploy/bookmgr.service /etc/systemd/system/bookmgr.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now bookmgr

[Unit]
Description=bookmgr book management service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bookmgr
Group=bookmgr
WorkingDirectory=/opt/bookmgr/server
EnvironmentFile=/etc/bookmgr/bookmgr.env
ExecStart=/opt/bookmgr/server/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
UMask=0077

# /var/lib/bookmgr is created and kept owned by bookmgr with mode 0700.
StateDirectory=bookmgr
StateDirectoryMode=0700

# Sandboxing: the only writable path is /var/lib/bookmgr. Outbound HTTPS to
# the Google Books API is required, so network access is not restricted by
# IP address. If the service fails with SIGSYS or "Permission denied",
# comment out the lines below one by one (MemoryDenyWriteExecute and
# SystemCallFilter are the usual suspects).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
