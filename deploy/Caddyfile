# Reverse proxy for bookmgr: terminates HTTPS (automatic Let's Encrypt
# certificate) and forwards plain HTTP to the FastAPI server running
# locally. Replace bookmgr.example.com with your actual domain; it must
# already resolve (DNS A/AAAA record) to this machine's public IP, and
# ports 80/443 must be reachable from the internet for the ACME challenge
# and HTTPS traffic.
#
# Run the FastAPI server with HOST=127.0.0.1 and COOKIE_SECURE=true so it
# only accepts connections from Caddy and marks the session cookie
# HTTPS-only (see README.md).
#
# The port below must match the PORT env var start.sh exports, NOT
# necessarily the app's built-in default (8080, see app/config.py). Pick a
# free port if 8080 is already used by another service on the same host
# (this repo's own production instance runs on 8090 for that reason).
#
# Usage: caddy run --config deploy/Caddyfile

bookmgr.example.com {
	# Security headers: force HTTPS on return visits (HSTS), forbid framing
	# (clickjacking), disable MIME sniffing, and keep URLs (which may carry
	# search queries) out of the Referer sent to other sites.
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:8090
}
